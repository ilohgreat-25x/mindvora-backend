/**
 * ╔══════════════════════════════════════════════════════════════════════╗
 * ║          MINDVORA — CRLF DEFENSE SYSTEM  ·  defense.evi            ║
 * ║                                                                      ║
 * ║  CRLF (Carriage-Return Line-Feed) Injection is a class of HTTP      ║
 * ║  header-splitting attacks where an attacker injects \r\n or the      ║
 * ║  encoded equivalents %0d%0a into HTTP headers/params to split        ║
 * ║  responses, hijack sessions, or poison caches.                       ║
 * ║                                                                      ║
 * ║  This module provides:                                               ║
 * ║   1. Deep CRLF sanitization of all inbound data                     ║
 * ║   2. Automatic IP banning after 5 suspicious requests (24h TTL)     ║
 * ║   3. Hardened security response headers                              ║
 * ║   4. Complete suppression of stack traces & internal API details     ║
 * ║   5. Rate-limiting (100 req/min per IP, sliding window)             ║
 * ╚══════════════════════════════════════════════════════════════════════╝
 */

'use strict';

// ── In-memory stores (replace with Redis in production clusters) ──────────
const suspiciousMap = new Map();  // ip → { count, bannedUntil }
const rateLimitMap  = new Map();  // ip → [timestamps...]

// ── Constants ─────────────────────────────────────────────────────────────
const MAX_VIOLATIONS    = 5;              // strikes before permanent ban
const BAN_DURATION_MS   = 24 * 60 * 60 * 1000; // 24 hours
const RATE_WINDOW_MS    = 60 * 1000;     // 1 minute sliding window
const RATE_MAX_REQUESTS = 150;           // max requests per window per IP

// ── CRLF pattern: catches raw and percent-encoded forms ───────────────────
// FIX: global (/g) regexes keep a lastIndex cursor, so reusing them with
// .test() made detection alternate true/false between calls. Separate
// non-global TEST patterns from global REPLACE patterns.
const CRLF_PATTERN = /(\r|\n|%0[dD]|%0[aA]|%00)/g;
const CRLF_TEST    = /(\r|\n|%0[dD]|%0[aA]|%00)/;

// ── Unicode / null byte injection patterns ────────────────────────────────
const NULL_BYTE_PATTERN = /\x00/g;
const NULL_BYTE_TEST    = /\x00/;

// ── Path traversal patterns ───────────────────────────────────────────────
const PATH_TRAVERSAL      = /(\.\.(\/|\\)|%2e%2e(%2f|%5c)|%252e%252e)/gi;
const PATH_TRAVERSAL_TEST = /(\.\.(\/|\\)|%2e%2e(%2f|%5c)|%252e%252e)/i;

// ── SQL injection detection — now actively BLOCKED, not just logged ───────
const SQL_DETECT = /(\bunion\b.*\bselect\b|\bselect\b.*\bfrom\b|\bdrop\b.*\btable\b|\bexec\b\s*\(|\binsert\b.*\binto\b|\bdelete\b.*\bfrom\b|\bor\b\s+['"]?1['"]?\s*=\s*['"]?1|--\s*$|;\s*--|\/\*.*\*\/|\bxp_cmdshell\b)/i;

/**
 * ─────────────────────────────────────────────────────────────────────────
 * BRUTE-FORCE PROTECTION — separate from the CRLF strike system above.
 * Used to lock out repeated FAILED attempts on sensitive auth endpoints
 * (OTP verification, admin auth) regardless of whether the request itself
 * looked malicious. Call recordAuthFailure() on a failed attempt and
 * clearAuthFailures() on success; check isAuthLocked() before processing.
 * ─────────────────────────────────────────────────────────────────────────
 */
const authFailMap = new Map(); // `${scope}:${ip}` -> { count, firstAt, lockedUntil }
const AUTH_MAX_FAILS  = 8;               // failed attempts allowed
const AUTH_WINDOW_MS  = 15 * 60 * 1000;  // within this window
const AUTH_LOCK_MS    = 30 * 60 * 1000;  // lock duration once exceeded

function isAuthLocked(ip, scope) {
  const rec = authFailMap.get(`${scope}:${ip}`);
  if (!rec) return false;
  if (rec.lockedUntil && rec.lockedUntil > Date.now()) return true;
  if (rec.lockedUntil && rec.lockedUntil <= Date.now()) {
    authFailMap.delete(`${scope}:${ip}`);
  }
  return false;
}

function recordAuthFailure(ip, scope) {
  const key = `${scope}:${ip}`;
  const now = Date.now();
  const rec = authFailMap.get(key) || { count: 0, firstAt: now, lockedUntil: 0 };
  if (now - rec.firstAt > AUTH_WINDOW_MS) {
    rec.count = 0;
    rec.firstAt = now;
  }
  rec.count += 1;
  if (rec.count >= AUTH_MAX_FAILS) {
    rec.lockedUntil = now + AUTH_LOCK_MS;
    console.warn(`[MINDVORA SECURITY] 🔒 Brute-force lockout: scope=${scope} ip=${ip} for ${AUTH_LOCK_MS / 60000}min`);
  }
  authFailMap.set(key, rec);
  return rec.lockedUntil > now;
}

function clearAuthFailures(ip, scope) {
  authFailMap.delete(`${scope}:${ip}`);
}

/**
 * Sanitize a string value by stripping CRLF, null bytes, path traversal.
 * Returns the cleaned string.
 */
function sanitizeValue(val) {
  if (typeof val !== 'string') return val;
  return val
    .replace(CRLF_PATTERN, '')
    .replace(NULL_BYTE_PATTERN, '')
    .replace(PATH_TRAVERSAL, '');
}

/**
 * Deep-sanitize an object (works on nested objects/arrays).
 */
function sanitizeDeep(obj) {
  if (obj === null || obj === undefined) return obj;
  if (typeof obj === 'string') return sanitizeValue(obj);
  if (Array.isArray(obj)) return obj.map(sanitizeDeep);
  if (typeof obj === 'object') {
    const out = {};
    for (const key of Object.keys(obj)) {
      out[sanitizeValue(key)] = sanitizeDeep(obj[key]);
    }
    return out;
  }
  return obj;
}

/**
 * Detect if a raw value contains CRLF injection attempt.
 */
function hasCRLF(val) {
  if (typeof val !== 'string') return false;
  return CRLF_TEST.test(val) || NULL_BYTE_TEST.test(val) || PATH_TRAVERSAL_TEST.test(val);
}

/**
 * Check all values in an object for CRLF.
 */
function objectHasCRLF(obj) {
  if (!obj || typeof obj !== 'object') return false;
  for (const key of Object.keys(obj)) {
    if (hasCRLF(key) || hasCRLF(String(obj[key] ?? ''))) return true;
    if (typeof obj[key] === 'object' && objectHasCRLF(obj[key])) return true;
  }
  return false;
}

/**
 * Record a violation for an IP and return whether it should be banned.
 */
function recordViolation(ip) {
  const now = Date.now();
  const rec = suspiciousMap.get(ip) || { count: 0, bannedUntil: 0 };

  // Already banned?
  if (rec.bannedUntil > now) return true;

  rec.count += 1;
  if (rec.count >= MAX_VIOLATIONS) {
    rec.bannedUntil = now + BAN_DURATION_MS;
    console.warn(`[MINDVORA SECURITY] 🚫 IP BANNED: ${ip} — exceeded ${MAX_VIOLATIONS} CRLF violation attempts. Ban expires: ${new Date(rec.bannedUntil).toISOString()}`);
  } else {
    console.warn(`[MINDVORA SECURITY] ⚠️  CRLF attempt #${rec.count} from IP: ${ip}`);
  }

  suspiciousMap.set(ip, rec);
  return rec.bannedUntil > now;
}

/**
 * Check if IP is currently banned.
 */
function isBanned(ip) {
  const rec = suspiciousMap.get(ip);
  if (!rec) return false;
  if (rec.bannedUntil > Date.now()) return true;
  // Ban expired — reset
  if (rec.bannedUntil && rec.bannedUntil <= Date.now()) {
    suspiciousMap.delete(ip);
  }
  return false;
}

/**
 * Rate-limit check: sliding window.
 * Returns true if the IP is over-limit.
 */
function isRateLimited(ip) {
  const now = Date.now();
  const timestamps = (rateLimitMap.get(ip) || []).filter(t => now - t < RATE_WINDOW_MS);
  timestamps.push(now);
  rateLimitMap.set(ip, timestamps);
  return timestamps.length > RATE_MAX_REQUESTS;
}

/**
 * Extract the real client IP, respecting proxy headers.
 */
function getClientIP(req) {
  // FIX: client-supplied CF-Connecting-IP / X-Real-IP / X-Forwarded-For[0]
  // are trivially spoofable, which let anyone bypass rate limits, IP bans
  // and the OTP brute-force lockout. req.ip honours app.set('trust proxy', 1)
  // (Render's single proxy hop), so it is the real client address.
  // Render documents that the FIRST X-Forwarded-For entry is the real client
  // (Render sets RENDER=true automatically). With 'trust proxy' = 1, req.ip
  // would be the LAST hop — a shared Render/Cloudflare edge IP — so one bad
  // actor could lock every user out of OTP. Use the first entry on Render.
  if (process.env.RENDER || process.env.TRUST_XFF_FIRST === 'true') {
    const first = String((req && req.headers && req.headers['x-forwarded-for']) || '').split(',')[0].trim();
    if (first) return first;
  }
  if (req && req.ip) return req.ip;
  if (req && req.socket && req.socket.remoteAddress) return req.socket.remoteAddress;
  return 'unknown';
}

// ── Security headers added to every response ──────────────────────────────
const SECURITY_HEADERS = {
  'X-Content-Type-Options':            'nosniff',
  'X-Frame-Options':                   'DENY',
  'X-XSS-Protection':                  '1; mode=block',
  'Strict-Transport-Security':         'max-age=31536000; includeSubDomains; preload',
  'Referrer-Policy':                   'strict-origin-when-cross-origin',
  'Permissions-Policy':                'geolocation=(), microphone=(self), camera=(self), payment=()',
  'Content-Security-Policy':           [
    "default-src 'self'",
    "script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://js.paystack.co https://upload-widget.cloudinary.com https://fonts.googleapis.com",
    "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
    "font-src 'self' https://fonts.gstatic.com",
    "img-src 'self' data: blob: https:",
    "connect-src 'self' wss: https:",
    "media-src 'self' blob:",
    "frame-ancestors 'none'",
  ].join('; '),
  'X-Mindvora-Protected':              'true',
};

/**
 * ─────────────────────────────────────────────────────────────────────────
 * MAIN MIDDLEWARE — crlfGuard
 *
 * Apply as the VERY FIRST middleware in your Express app:
 *   const { crlfGuard } = require('./CRLF/defense.evi');
 *   app.use(crlfGuard);
 * ─────────────────────────────────────────────────────────────────────────
 */
function crlfGuard(req, res, next) {
  const ip = getClientIP(req);

  // 1. Apply security headers to EVERY response
  for (const [header, value] of Object.entries(SECURITY_HEADERS)) {
    res.setHeader(header, value);
  }
  res.removeHeader('X-Powered-By');
  res.removeHeader('Server');

  // 2. Check IP ban
  if (isBanned(ip)) {
    return res.status(403).json({
      error: 'Access denied. Your IP has been temporarily blocked due to suspicious activity.',
      code: 'IP_BANNED'
    });
  }

  // 3. Rate limiting
  if (isRateLimited(ip)) {
    console.warn(`[MINDVORA SECURITY] 🌊 Rate limit exceeded: ${ip}`);
    return res.status(429).json({
      error: 'Too many requests. Please slow down.',
      code: 'RATE_LIMITED',
      retryAfter: 60
    });
  }

  // 4. Detect CRLF in headers
  const headerString = JSON.stringify(req.headers);
  const hasCRLFHeaders = CRLF_TEST.test(headerString) || NULL_BYTE_TEST.test(headerString);

  // 5. Detect CRLF in query params
  const hasCRLFQuery = objectHasCRLF(req.query);

  // 6. Detect CRLF in URL path
  const hasCRLFPath = CRLF_TEST.test(req.url) || PATH_TRAVERSAL_TEST.test(req.url);

  if (hasCRLFHeaders || hasCRLFQuery || hasCRLFPath) {
    const banned = recordViolation(ip);
    if (banned) {
      return res.status(403).json({
        error: 'Access denied. Suspicious request pattern detected. Your IP has been banned.',
        code: 'CRLF_INJECTION_BAN'
      });
    }
    return res.status(400).json({
      error: 'Bad request. Invalid characters detected in request.',
      code: 'CRLF_INJECTION_ATTEMPT'
    });
  }

  // 7. Sanitize query params (in-place)
  if (req.query) {
    req.query = sanitizeDeep(req.query);
  }

  // 8. Sanitize body after parsing (body-parser must run first — hook via response)
  const originalJson = res.json.bind(res);
  
  // 9. Wrap res.json to strip stack traces from outbound responses
  res.json = function(data) {
    if (data && typeof data === 'object') {
      // Never leak stack traces or internal details
      delete data.stack;
      delete data.stacktrace;
      delete data.internalError;
      delete data.sqlState;
      delete data.errno;
      delete data.code_internal;

      // In production, replace detailed error messages
      if (process.env.NODE_ENV === 'production' && data.message && data.message.length > 200) {
        data.message = 'An error occurred. Please try again.';
      }
    }
    return originalJson(data);
  };

  // 10. Detect and BLOCK suspicious SQL patterns in URL / query.
  // (The body is not parsed yet at this point — see bodyGuard below.)
  const urlQueryStr = JSON.stringify({ url: req.url, query: req.query });
  if (SQL_DETECT.test(urlQueryStr)) {
    const banned = recordViolation(ip);
    console.warn(`[MINDVORA SECURITY] 🚨 SQLi pattern BLOCKED from IP: ${ip} — ${req.method} ${req.url}`);
    return res.status(400).json({
      error: banned ? 'Access denied. Your IP has been banned.' : 'Bad request. Invalid data in request.',
      code: banned ? 'SQLI_BAN' : 'SQLI_ATTEMPT'
    });
  }

  next();
}

/**
 * FIX: body checks used to live inside crlfGuard, which runs BEFORE
 * express.json(), so req.body was always undefined and request bodies were
 * never inspected or sanitized. Mount this AFTER the body parsers.
 */
function bodyGuard(req, res, next) {
  if (!req.body || typeof req.body !== 'object') return next();
  const ip = getClientIP(req);
  if (objectHasCRLF(req.body)) {
    const banned = recordViolation(ip);
    return res.status(banned ? 403 : 400).json({
      error: banned ? 'Access denied. Your IP has been banned.' : 'Bad request. Invalid data in request body.',
      code: banned ? 'BODY_CRLF_BAN' : 'BODY_CRLF_ATTEMPT'
    });
  }
  if (SQL_DETECT.test(JSON.stringify(req.body))) {
    const banned = recordViolation(ip);
    console.warn(`[MINDVORA SECURITY] 🚨 SQLi pattern BLOCKED in body from IP: ${ip} — ${req.method} ${req.url}`);
    return res.status(400).json({
      error: banned ? 'Access denied. Your IP has been banned.' : 'Bad request. Invalid data in request.',
      code: banned ? 'SQLI_BAN' : 'SQLI_ATTEMPT'
    });
  }
  req.body = sanitizeDeep(req.body);
  next();
}

/**
 * Error handler middleware — attach AFTER all routes.
 * Prevents ANY stack trace or internal detail from leaking.
 */
function secureErrorHandler(err, req, res, next) {
  const ip = getClientIP(req);
  // Log full error server-side only
  console.error(`[MINDVORA ERROR] ${new Date().toISOString()} | IP: ${ip} | ${req.method} ${req.url}`, err);

  // Send only generic message to client
  if (res.headersSent) return next(err);
  
  res.status(err.status || 500).json({
    error: process.env.NODE_ENV === 'production'
      ? 'Something went wrong. Please try again later.'
      : err.message,
    code: err.code || 'INTERNAL_ERROR'
  });
}

/**
 * Utility: get current ban list (for admin dashboard).
 */
function getBanList() {
  const now = Date.now();
  const bans = [];
  for (const [ip, rec] of suspiciousMap.entries()) {
    if (rec.bannedUntil > now) {
      bans.push({
        ip,
        violations: rec.count,
        bannedUntil: new Date(rec.bannedUntil).toISOString(),
        remainingMs: rec.bannedUntil - now
      });
    }
  }
  return bans;
}

/**
 * Utility: manually unban an IP (admin action).
 */
function unbanIP(ip) {
  suspiciousMap.delete(ip);
  console.warn(`[MINDVORA SECURITY] ✅ IP manually unbanned: ${ip}`);
}

// ── Periodic cleanup of expired entries (every hour) ──────────────────────
setInterval(() => {
  const now = Date.now();
  for (const [ip, rec] of suspiciousMap.entries()) {
    if (rec.bannedUntil && rec.bannedUntil <= now) {
      suspiciousMap.delete(ip);
    }
  }
  for (const [ip, timestamps] of rateLimitMap.entries()) {
    const fresh = timestamps.filter(t => now - t < RATE_WINDOW_MS);
    if (fresh.length === 0) rateLimitMap.delete(ip);
    else rateLimitMap.set(ip, fresh);
  }
  for (const [key, rec] of authFailMap.entries()) {
    if (rec.lockedUntil && rec.lockedUntil <= now && now - rec.firstAt > AUTH_WINDOW_MS) {
      authFailMap.delete(key);
    }
  }
}, 60 * 60 * 1000);

module.exports = {
  crlfGuard,
  bodyGuard,
  secureErrorHandler,
  getBanList,
  unbanIP,
  sanitizeValue,
  sanitizeDeep,
  isAuthLocked,
  recordAuthFailure,
  clearAuthFailures,
  getClientIP,
};
